{
  "expo": {
    "name": "Retail Automate",
    "slug": "retail-automate-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1e1b4b"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e1b4b"
      },
      "package": "com.retailautomate.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Retail Automate to access your photos to upload shopping lists."
        }
      ],
      "expo-font"
    ],
    "scheme": "retailautomate",
    "extra": {
      "eas": {
        "projectId": "5afd994a-c38d-4de8-b5b6-7519009ececd"
      }
    }
  }
}
